# Maintainer: Omarchy Files contributors <https://github.com/spalencsar/omarchy-files>

pkgname=omarchy-files-git
pkgver=0.1.0.r0.00000000
pkgrel=1
pkgdesc='Standalone Wayland file manager for Omarchy'
arch=('x86_64' 'aarch64')
url='https://github.com/spalencsar/omarchy-files'
license=('MIT')
depends=('quickshell' 'polkit')
makedepends=('git' 'go' 'make')
optdepends=(
  'bubblewrap: sandbox external thumbnailers'
  'ffmpegthumbnailer: video thumbnails'
  'poppler: PDF thumbnails'
  'udisks2: devices sidebar'
  'gvfs: network shares and removable-drive trash'
  'qt6-webengine: PDF preview'
)
provides=('omarchy-files')
conflicts=('omarchy-files')
source=(
  "$pkgname::git+$url.git"
  'dux-qml-common-802b4b127b482d85921e464ccc7cd629294b47e3.tar.gz::https://github.com/duxlabs-dev/dux-qml-common/archive/802b4b127b482d85921e464ccc7cd629294b47e3.tar.gz'
)
sha256sums=('SKIP' '6922ebc1d70969a9bb1807c25517d90d1404b8f0a1869c4dd883e10d7290550b')

pkgver() {
  cd "$srcdir/$pkgname"
  local tag count
  tag="$(git describe --tags --abbrev=0 2>/dev/null || true)"
  if [[ -z "$tag" ]]; then
    tag="0.0.0"
    count="$(git rev-list --count HEAD)"
  else
    tag="${tag#v}"
    count="$(git rev-list --count "$tag"..HEAD)"
  fi
  printf '%s.r%s.%s' "$tag" "$count" "$(git rev-parse --short=8 HEAD)"
}

prepare() {
  cd "$srcdir/$pkgname"
  rm -rf dux-qml-common
  cp -a "$srcdir/dux-qml-common-802b4b127b482d85921e464ccc7cd629294b47e3" dux-qml-common
}

build() {
  cd "$srcdir/$pkgname"
  GOFLAGS='-buildvcs=false' make
  GOFLAGS='-buildvcs=false' make -C core completions
}

check() {
  cd "$srcdir/$pkgname"
  GOFLAGS='-buildvcs=false' make test
}

package() {
  cd "$srcdir/$pkgname"
  make -C core DESTDIR="$pkgdir" PREFIX=/usr install
  make DESTDIR="$pkgdir" PREFIX=/usr install
  install -Dm644 assets/systemd/omarchy-files.service \
    "$pkgdir/usr/lib/systemd/user/omarchy-files.service"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
